; Engine configuration file.
; Godot 4.4+: open this folder in the Project Manager (Import -> project.godot).

config_version=5

[application]

config/name="JBI (Godot prototype)"
config/description="ЖБИ, Екатеринбург: прототип скейта в ретро-стиле PS2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Controls="*res://scripts/controls.gd"

[display]

window/size/viewport_width=854
window/size/viewport_height=480
window/size/window_width_override=1708
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.62, 0.72, 0.82, 1)
